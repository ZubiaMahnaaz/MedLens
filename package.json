{
  "name": "medlens-app",
  "version": "1.0.0",
  "type": "module",
  "description": "MedLens — AI-Powered Clinical Information Intelligence Full-Stack Web Application",
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "dev": "node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "test:backend": "node server/test_e2e.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289",
    "sql.js": "^1.12.0"
  }
}
